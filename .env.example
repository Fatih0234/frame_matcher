# Label Studio Configuration
LABEL_STUDIO_URL=http://your-labelstudio-server:port
LABEL_STUDIO_API_KEY=your-api-key-here

# NOTE: PROJECT_ID is now optional and only used for backward compatibility
# When not specified, you can select projects interactively or via --project-ids CLI argument
# PROJECT_ID=your-project-id

# Example:
# LABEL_STUDIO_URL=http://10.21.12.67
# LABEL_STUDIO_API_KEY=519b2038c9c45a461bab720013d98373873a998a
# PROJECT_ID=5  # Optional - for backward compatibility with single project workflows
