# Label Studio Configuration
LABEL_STUDIO_URL=http://your-labelstudio-server:port
LABEL_STUDIO_API_KEY=your-api-key-here

# Example:
# LABEL_STUDIO_URL=http://192.168.1.100:8080
# LABEL_STUDIO_API_KEY=abc123def456...your-actual-api-key-here

# Note: Project selection is done via --project-ids CLI parameter or interactively
